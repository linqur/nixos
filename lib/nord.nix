# Официальная палитра Nord: https://www.nordtheme.com/docs/colors-and-palettes
{
  # Polar Night — фоны тёмной темы
  nord0 = "#2e3440";  # основной фон
  nord1 = "#3b4252";  # панели, попапы, поля ввода, рамки
  nord2 = "#434c5e";  # выделение и активная строка
  nord3 = "#4c566a";  # приглушённый текст, направляющие

  # Snow Storm — текст
  nord4 = "#d8dee9";  # основной текст
  nord5 = "#e5e9f0";  # hover/active
  nord6 = "#eceff4";  # текст, требующий внимания

  # Frost — акценты (одинаковы в светлой и тёмной теме)
  nord7 = "#8fbcbb";
  nord8 = "#88c0d0";  # главный акцент
  nord9 = "#81a1c1";  # вторичные элементы
  nord10 = "#5e81ac"; # третичные элементы

  # Aurora — состояния
  nord11 = "#bf616a"; # ошибка
  nord12 = "#d08770";
  nord13 = "#ebcb8b"; # предупреждение
  nord14 = "#a3be8c"; # успех
  nord15 = "#b48ead";
}
